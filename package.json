{
  "name": "create-nasti",
  "version": "3.0.0",
  "description": "Scaffold a new Nasti project — npm create nasti@latest",
  "keywords": [
    "Nasti",
    "create",
    "scaffold",
    "rolldown",
    "tanstack"
  ],
  "homepage": "https://github.com/zixiao-labs/create-nasti#readme",
  "bugs": {
    "url": "https://github.com/zixiao-labs/create-nasti/issues"
  },
  "repository": {
