    "url": "git+https://github.com/zixiao-labs/create-nasti.git"
  },
  "license": "MIT",
  "author": "Zixiao Laboratories",
  "type": "module",
  "bin": {
    "create-nasti": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
